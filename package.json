{
  "name": "verlift",
  "version": "1.0.2",
  "description": "CLI tool for scanning package licenses and bumping project versions. Supports both web and React Native projects.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "verlift": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "tsc",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "license",
    "scan",
    "version",
    "bump",
    "cli"
  ],
  "author": "ernestbies",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.32.0"
  }
}
