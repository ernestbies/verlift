{
  "name": "verlift",
  "version": "1.0.4",
  "description": "CLI tool for scanning package licenses and bumping project versions. Supports both web and React Native projects.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "verlift": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "tsc",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ernestbies/verlift.git"
  },
  "keywords": [
    "license",
    "license-checking",
    "license-scanning",
    "scan",
    "version",
    "bump",
    "bump-version",
    "cli"
  ],
  "author": "ernestbies",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
